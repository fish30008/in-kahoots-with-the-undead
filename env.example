# Copy to .env and adjust. Everything here has a default in compose.yml except
# the base and crafting database passwords, which must be set.

# --- Images ---------------------------------------------------------------
# Docker Hub account the player and game images are published under.
DOCKERHUB_USERNAME=fish30008
PLAYER_SERVICE_TAG=latest
GAME_SERVICE_TAG=latest

# --- Shared ---------------------------------------------------------------
# X-Internal-Key. Must be identical across services: game fetches the JWKS from
# player's internal endpoint with it, so a mismatch rejects every cookie.
INTERNAL_KEY=changeme
# true anywhere the stack is reachable over HTTPS.
COOKIE_SECURE=false
LOG_LEVEL=info

# --- Player service (services/player_service, Go, :8081) ------------------
PLAYER_PORT=8081
PLAYER_POSTGRES_USER=postgres
PLAYER_POSTGRES_PASSWORD=qwerty
PLAYER_POSTGRES_DB=player
# RS256 signing key and its stable kid, published through GET /auth/jwks.
JWT_PRIVATE_KEY=supersecret
JWT_KID=2026-09

# --- Game service (services/game_service, Node 22, :8082) -----------------
GAME_PORT=8082
GAME_POSTGRES_USER=game
GAME_POSTGRES_PASSWORD=qwerty
GAME_POSTGRES_DB=game_service
# Host port for game-db, 5433 so it does not collide with a local Postgres.
# Also the database the store contract tests run against:
# TEST_DATABASE_URL=postgres://game:qwerty@localhost:5433/game_service
GAME_POSTGRES_PORT=5433

# Neighbours. An empty URL makes game use its built-in mock for that service,
# so only uncomment one once the real service answers game's contract.
# PLAYER_SERVICE_URL defaults to http://player:8081 inside the compose network.
# PLAYER_SERVICE_URL=http://player:8081
# BASE_SERVICE_URL=http://base:8087
# WORLD_SERVICE_URL=
# ZOMBIE_SERVICE_URL=
# EXAM_SERVICE_URL=
# RESOURCE_SERVICE_URL=

# Day/night cycle. The contract fixes these at 600/300; shorten them only to
# demo or test a full cycle in seconds.
DAY_PHASE_SECONDS=600
NIGHT_PHASE_SECONDS=300
TICK_INTERVAL_MS=1000
JWKS_CACHE_SECONDS=3600

# --- Base service (teammate's image) --------------------------------------
BASE_DOCKERHUB_USERNAME=mixam052
BASE_SERVICE_TAG=0.1.0
BASE_PORT=8087
BASE_POSTGRES_USER=postgres
BASE_POSTGRES_PASSWORD=change-me
BASE_POSTGRES_DB=base

# --- Crafting service (teammate's image) ----------------------------------
CRAFTING_DOCKERHUB_USERNAME=mixam052
CRAFTING_SERVICE_TAG=0.1.0
CRAFTING_PORT=8088
CRAFTING_POSTGRES_USER=postgres
CRAFTING_POSTGRES_PASSWORD=change-me
CRAFTING_POSTGRES_DB=crafting
