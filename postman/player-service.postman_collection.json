{
  "info": {
    "name": "Player Service",
    "description": "Happy-path collection for the Player Service, run through the Gateway. Run the whole collection from top to bottom (Postman Runner): a player registers and logs in, an item is added to the catalog, granted and consumed, then the players are deleted. IDs, codes and the access token are passed between requests through collection variables, so the collection can be re-run as many times as you want.\n\n{{baseUrl}} is the Gateway (default http://localhost:8080): it checks the token, removes it, and forwards /auth and /players to the Player Service. Every request sends Authorization: Bearer {{token}}, set by the Log in request; register and login need none. The Gateway must run with AUTH_MODE=secret and the same JWT_SECRET as the Player Service.\n\n{{playerUrl}} is the Player Service itself (default http://localhost:8081), used only for its /health, which the Gateway does not forward.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "description": "The Gateway."
    },
    {
      "key": "playerUrl",
      "value": "http://localhost:8081",
      "description": "The Player Service itself, for its health check only."
    },
    {
      "key": "password",
      "value": "hunter2hunter2"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "secondUsername",
      "value": ""
    },
    {
      "key": "secondPlayerId",
      "value": ""
    },
    {
      "key": "itemCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('service and database are up', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('ok');",
                  "    pm.expect(body.database).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{playerUrl}}/health",
            "description": "Confirms the service is running and can reach PostgreSQL.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('the Gateway is up', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
      "description": "Register and log in are the only two routes the Gateway lets through without a token.",
      "item": [
        {
          "name": "A request without a token is 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/players",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('refused by the Gateway, before reaching the service', () => {",
                  "    pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@utm.md\",\n  \"display_name\": \"Alice\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh username every run, so the collection never hits a duplicate.",
                  "pm.collectionVariables.set('username', 'alice_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('new player starts at level 1 with 0 XP', () => {",
                  "    pm.expect(body.xp).to.eql(0);",
                  "    pm.expect(body.level).to.eql(1);",
                  "    pm.expect(body.is_online).to.eql(false);",
                  "});",
                  "pm.test('the password is never sent back', () => {",
                  "    pm.expect(body).to.not.have.property('password');",
                  "    pm.expect(body).to.not.have.property('password_hash');",
                  "});",
                  "pm.collectionVariables.set('playerId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registering the same username is 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "A wrong password is 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"not-the-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('an access token is issued for the player who registered', () => {",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "    pm.expect(body.token_type).to.eql('Bearer');",
                  "    pm.expect(body.player.id).to.eql(pm.collectionVariables.get('playerId'));",
                  "});",
                  "// Every later request sends this as Authorization: Bearer.",
                  "pm.collectionVariables.set('token', body.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "Create second player",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('secondUsername', 'bob_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('secondPlayerId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{secondUsername}}\",\n  \"display_name\": \"Bob\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/players",
            "description": "POST /players still creates a player, but one without a password: they cannot log in."
          }
        },
        {
          "name": "List players",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/players?limit=20&offset=0",
            "description": "Paginated list, newest players first."
          }
        },
        {
          "name": "Get player by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the player we created', () => {",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('playerId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/players/{{playerId}}"
          }
        },
        {
          "name": "Update player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('display name changed', () => pm.expect(body.display_name).to.eql('Alice the Survivor'));",
                  "pm.test('username was left untouched', () => {",
                  "    pm.expect(body.username).to.eql(pm.collectionVariables.get('username'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Alice the Survivor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/players/{{playerId}}",
            "description": "Partial update: fields left out of the body keep their current value."
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Create item",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Item codes are unique, so generate one per run.",
                  "pm.collectionVariables.set('itemCode', 'coffee_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('stored as a consumable', () => {",
                  "    pm.expect(pm.response.json().category).to.eql('consumable');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{itemCode}}\",\n  \"name\": \"Coffee\",\n  \"category\": \"consumable\",\n  \"description\": \"Keeps you awake through the night cycle\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/players/items",
            "description": "Adds a catalog entry. category is either consumable or cosmetic."
          }
        },
        {
          "name": "List items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('our item is in the catalog', () => {",
                  "    const codes = pm.response.json().map(i => i.code);",
                  "    pm.expect(codes).to.include(pm.collectionVariables.get('itemCode'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/players/items"
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Grant 5 items to player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('player now holds 5', () => pm.expect(pm.response.json().quantity).to.eql(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_code\": \"{{itemCode}}\",\n  \"quantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/players/{{playerId}}/inventory",
            "description": "Grants items. Called again with the same item, it adds to the amount already held."
          }
        },
        {
          "name": "Consume 2 items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('3 left after consuming 2 of 5', () => pm.expect(pm.response.json().quantity).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_code\": \"{{itemCode}}\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/players/{{playerId}}/inventory/consume",
            "description": "Uses up items, for example drinking a coffee."
          }
        },
        {
          "name": "Get player inventory",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('inventory shows 3 of our item, with catalog details', () => {",
                  "    const line = pm.response.json().find(e => e.item_code === pm.collectionVariables.get('itemCode'));",
                  "    pm.expect(line, 'inventory line').to.not.be.undefined;",
                  "    pm.expect(line.quantity).to.eql(3);",
                  "    pm.expect(line.item_name).to.eql('Coffee');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/players/{{playerId}}/inventory",
            "description": "Every line the player owns, joined with the item catalog."
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/players/{{playerId}}",
            "description": "Deleting a player also removes their inventory rows (ON DELETE CASCADE)."
          }
        },
        {
          "name": "Delete second player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/players/{{secondPlayerId}}"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}
