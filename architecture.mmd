flowchart TB
    %% ranks, top to bottom: browser, gateway, broker, our services, then the teammates and Discovery side by side, Telegram

    client(["<b>Game client</b> · browser · nginx on :3000, /api proxied to the gateway"])

    gateway["<b>API Gateway</b> · Python / FastAPI · :8080 · the door for clients<br/>JWT check, X-Player-Id, task limits · knows the service from the path and puts the request on <b>its queue in the broker</b><br/><b>players only</b>: routes for services (/…/internal/…, POST /players/{id}/xp, …) → 404 · GET /ws/game → a Game copy, chosen by the broker<br/>X-Request-Id on every request<br/><b>cache</b> (Lab 5): GET responses and verified tokens · the node for a key is picked on a <b>consistent hash ring</b> (100 points per node) · X-Cache: HIT / MISS · POST /auth/logout revokes a token"]

    broker["<b>Message Broker</b> (Lab 4) · Python, standard library only · :8070 · the door between services<br/><b>one thread per request</b> (ThreadingHTTPServer, HTTP/1.0) · 429 above MAX_CONCURRENT_TASKS · GET /topics<br/><b>gRPC :50051</b>: player.Player/* forwarded undecoded to a Player copy · events.Broker/Publish<br/><b>subscriber queue per service</b>: /queues/&lt;service&gt;/… from the gateway, /&lt;prefix&gt;/… between services · workers hand each message to one copy<br/><b>topics</b>: Publish → events.Consumer/Deliver on one copy of every subscribing service · subscriptions read from Discovery<br/><b>load-based</b>: fewest calls in progress · <b>circuit breaker</b>: 3 failures within TASK_TIMEOUT × 3.5 → removed and deregistered<br/><b>rerouting</b>: a failed call goes to another copy · <b>durable queues</b> in SQLite (broker-data) · <b>dead letter channel</b>: GET /dead-letters<br/><b>saga coordinator</b> (Lab 5): POST /game/sessions/{id}/players is not forwarded: step 1 Player (online), step 2 Game (seat), undone in reverse when one fails · every step in SQLite, an interrupted saga is compensated at start · GET /sagas"]

    subgraph playercopies["Player (ours, Go) · 2 copies · replicas, no host port · share player-db (Lab 5: primary + 2 replicas)"]
        direction LR
        player1["<b>player-1</b> · :8081 REST · :9081 gRPC<br/>accounts, login + JWT, XP,<br/>items, inventory, trades"]
        player2["<b>player-2</b> · :8081<br/>same image"]
    end

    subgraph gamecopies["Game (ours, Go) · 2 copies · share game-db · live events between them via Postgres NOTIFY / LISTEN · clock on the advisory-lock holder"]
        direction LR
        game1["<b>game</b> · :8082 · :9082 gRPC<br/>sessions, day/night,<br/>actions, zombies"]
        game2["<b>game-2</b> · :8083<br/>same image"]
    end

    subgraph team["Teammates' services · fixed URLs · own PostgreSQL each · among them: exam.completed, world.wing_unlocked"]
        direction LR
        exam["<b>Exam</b><br/>NestJS"]
        world["<b>World</b><br/>NestJS"]
        zombie["<b>Zombie</b><br/>NestJS"]
        resource["<b>Resource</b><br/>NestJS"]
        base["<b>Base</b><br/>Go"]
        crafting["<b>Crafting</b><br/>Go"]
    end

    discovery["<b>Service Discovery</b> · Python / FastAPI · :8090<br/>in-memory registry: /register (with topics, gRPC address) · /deregister · /services · /grpc · /subscriptions · /services/health<br/><b>health check</b> of every copy every 10 s: ok · critical (≥ 80 % or refusing) · unhealthy<br/>drops copies not renewed for 45 s"]

    telegram(["<b>Telegram</b> · developers' chat · ALERT · RESOLVED · REMOVED"])

    logs[("<b>logs volume</b> · /logs/&lt;service&gt;-&lt;hostname&gt;.log, rotated at 5 MB, 3 kept<br/>written by gateway, discovery, broker, every Player and Game copy<br/>one shape: time LEVEL [service-component] message req=…")]


    %% data stores (Lab 5: drawn at last, with replicas, warehouse and cache)
    subgraph cache["Cache (Lab 5) · 3 independent Redis nodes, memory only · sharded by consistent hashing, in the Gateway · a node down: only its keys move"]
        direction LR
        cache1[("<b>cache-1</b>")]
        cache2[("<b>cache-2</b>")]
        cache3[("<b>cache-3</b>")]
    end

    brokerdata[("<b>broker-data</b> · SQLite volume<br/>durable topic queues, subscriptions,<br/>dead letters, sagas and their steps")]

    subgraph playerdb["player-db (Lab 5) · PostgreSQL 17 · streaming replication, automatic failover by repmgr (~30 s) · db/replication/start.sh: a restarted node waits until its partners agree on the primary"]
        direction LR
        playerdb0[("<b>player-db-0</b> · primary at first start<br/>players, items, inventory,<br/>trades, outbox_events")]
        playerdb1[("<b>player-db-1</b><br/>replica")]
        playerdb2[("<b>player-db-2</b><br/>replica")]
        playerdb0 == "WAL" ==> playerdb1
        playerdb0 == "WAL" ==> playerdb2
    end

    subgraph gamedb["game-db (Lab 5) · PostgreSQL 17 · streaming replication, automatic failover by repmgr · same start guard"]
        direction LR
        gamedb0[("<b>game-db-0</b> · primary at first start<br/>sessions, members, actions, zombies,<br/>outbox_events, received_events")]
        gamedb1[("<b>game-db-1</b><br/>replica")]
        gamedb2[("<b>game-db-2</b><br/>replica")]
        gamedb0 == "WAL" ==> gamedb1
        gamedb0 == "WAL" ==> gamedb2
    end

    teamdb[("<b>6 PostgreSQL databases</b>, one per teammate service<br/>exam-db · world-db · zombie-db · resource-db · base-db · crafting-db")]

    etl["<b>ETL job</b> (Lab 5) · etl/etl.sh in a stock Postgres image · every 10 s<br/><b>extract</b>: COPY out of a replica of the Player and of the Game database (read-only sessions)<br/><b>transform + load</b>: staging → dim_player, fact_session, fact_action"]

    warehouse[("<b>Data Warehouse</b> (Lab 5) · warehouse-db · PostgreSQL<br/>stg_* · dim_player · fact_session · fact_action · etl_runs")]

    %% who stores where
    gateway -- "GET responses · verified tokens" --> cache
    broker -- "events, dead letters, saga steps" --> brokerdata
    playercopies -- "SQL · three hosts in the URL, keeps the one that takes writes" --> playerdb
    gamecopies -- "SQL · same · NOTIFY / LISTEN and the clock lock re-opened after a failover" --> gamedb
    team --> teamdb
    playerdb -. "read from a replica" .-> etl
    gamedb -. "read from a replica" .-> etl
    etl -- "load" --> warehouse

    %% browser
    client -- "REST · cookie or Bearer" --> gateway
    client -. "WebSocket, direct · URL from GET /ws/game" .-> gamecopies

    %% every request through the broker
    gateway -- "/queues/&lt;service&gt;/… · every client request" --> broker
    broker -- "player queue (REST) · player.Player and events.Consumer (gRPC) · least loaded" --> playercopies
    broker -- "game queue (REST) · events.Consumer (gRPC) · least loaded" --> gamecopies
    broker -- "exam, world, zombie, resource, base, crafting queues" --> team
    gamecopies == "gRPC player.Player/* · events.Broker/Publish<br/>REST /world · internal key" ==> broker
    playercopies == "gRPC events.Broker/Publish:<br/>player.registered, player.leveled_up" ==> broker
    team -- "their calls to each other (REST, X-Internal-Key) · GATEWAY_URL = broker" --> broker

    %% control plane, straight to Discovery
    playercopies == "POST /register every 15 s<br/>GET /health every 10 s" ==> discovery
    gamecopies == "POST /register every 15 s<br/>GET /health every 10 s" ==> discovery
    gateway == "POST /register every 15 s" ==> discovery
    broker == "GET /services, /grpc, /subscriptions every 5 s<br/>POST /deregister on a breaker trip" ==> discovery
    broker -- "GET /logs (X-Internal-Key): every file merged by time" --> logs
    discovery -- "alerts" --> telegram

    %% monitoring
    subgraph monitoring["Monitoring · docker compose"]
        direction LR
        prometheus["<b>Prometheus</b> · :9090<br/>scrapes /metrics on :9100 of every copy"]
        alloy["<b>Alloy</b><br/>every container's output,<br/>via the Docker socket"]
        loki["<b>Loki</b><br/>logs, labels: service, level, tag"]
        grafana["<b>Grafana</b> · :3001<br/>one dashboard: metrics, logs,<br/>warehouse analytics"]
    end
    prometheus -- "GET /prometheus: what to scrape" --> discovery
    alloy --> loki
    grafana --> prometheus
    grafana --> loki
    grafana -- "Analytics row (SQL)" --> warehouse

    %% events for the teammates' services (/events WebSockets, URL negotiated with the broker)
    playercopies -. "player.registered<br/>player.leveled_up" .-> team
    gamecopies -. "game.action_completed" .-> team

    legend["<b>Legend</b> · solid: REST, every request through the broker · thick into the broker: gRPC between our services<br/>thick into Discovery: registration, health checks, the registry and subscriptions · dashed: WebSockets opened directly<br/>green border: ours · dark: Python (banned language) · blue: Go · yellow: NestJS · cylinders: data stores"]
