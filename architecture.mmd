flowchart TB
    %% ranks, top to bottom: browser, gateway, our services, then the teammates and Discovery side by side, Telegram

    client(["<b>Game client</b> · browser · nginx on :3000, /api proxied to the gateway"])

    gateway["<b>API Gateway</b> · Python / FastAPI · :8080 · the one door for all REST<br/>JWT check, X-Player-Id, task limits · <b>round robin</b> over the copies listed in Discovery<br/><b>circuit breaker</b>: 3 failures of a copy within TASK_TIMEOUT × 3.5 → removed · GET /ws/game → a Game copy, in turn<br/><b>GET /logs</b> (X-Internal-Key): every service's log file merged by time · ?service ?level ?contains ?lines · X-Request-Id on every request"]

    broker["<b>Message Broker</b> (Lab 4) · Python, standard library only · :8070<br/><b>one thread per request</b> (ThreadingHTTPServer, HTTP/1.0) · 429 above MAX_CONCURRENT_TASKS · GET /health<br/>next steps: a queue per service (gateway → service), topics (service → subscribers),<br/>load balancing and circuit breakers moved here from the gateway"]

    subgraph playercopies["Player (ours, Go) · 2 copies · replicas, no host port · share player-db"]
        direction LR
        player1["<b>player-1</b> · :8081<br/>accounts, login + JWT, XP,<br/>items, inventory, trades"]
        player2["<b>player-2</b> · :8081<br/>same image"]
    end

    subgraph gamecopies["Game (ours, Go) · 2 copies · share game-db · live events between them via Postgres NOTIFY / LISTEN · clock on the advisory-lock holder"]
        direction LR
        game1["<b>game</b> · :8082<br/>sessions, day/night,<br/>actions, zombies"]
        game2["<b>game-2</b> · :8083<br/>same image"]
    end

    subgraph team["Teammates' services · fixed URLs · own PostgreSQL each · among them: exam.completed, world.wing_unlocked"]
        direction LR
        exam["<b>Exam</b><br/>NestJS"]
        world["<b>World</b><br/>NestJS"]
        zombie["<b>Zombie</b><br/>NestJS"]
        resource["<b>Resource</b><br/>NestJS"]
        base["<b>Base</b><br/>Go"]
        crafting["<b>Crafting</b><br/>Go"]
    end

    discovery["<b>Service Discovery</b> · Python / FastAPI · :8090<br/>in-memory registry: /register · /deregister · /services · /services/health<br/><b>health check</b> of every copy every 10 s: ok · critical (≥ 80 % or refusing) · unhealthy<br/>drops copies not renewed for 45 s"]

    telegram(["<b>Telegram</b> · developers' chat · ALERT · RESOLVED · REMOVED"])

    logs[("<b>logs volume</b> · /logs/&lt;service&gt;-&lt;hostname&gt;.log, rotated at 5 MB, 3 kept<br/>written by gateway, discovery, broker, every Player and Game copy<br/>one shape: time LEVEL [service-component] message req=…")]

    %% browser
    client -- "REST · cookie or Bearer" --> gateway
    client -. "WebSocket, direct · URL from GET /ws/game" .-> gamecopies

    %% REST through the gateway
    gateway -- "/auth /players /trades · round robin" --> playercopies
    gateway -- "/game · round robin" --> gamecopies
    gateway -- "/exams /world /zombies /resources /base /crafting" --> team

    %% control plane, straight to Discovery
    playercopies == "POST /register every 15 s<br/>GET /health every 10 s" ==> discovery
    gamecopies == "POST /register every 15 s<br/>GET /health every 10 s" ==> discovery
    gateway == "GET /services every 5 s<br/>POST /deregister on a breaker trip" ==> discovery
    broker == "POST /register every 15 s<br/>GET /health every 10 s" ==> discovery
    gateway -- "GET /logs reads every file" --> logs
    gateway --o|"planned: every request through the broker"| broker
    discovery -- "alerts" --> telegram

    %% events for other services (/events WebSockets)
    playercopies -. "player.registered<br/>player.leveled_up" .-> team
    gamecopies -. "game.action_completed" .-> team

    legend["<b>Legend</b> · solid: REST through the gateway (service-to-service calls too, with X-Internal-Key)<br/>thick: registration, health checks and the registry, straight to Discovery · dashed: WebSockets opened directly<br/>circle end: planned in the next steps of Lab 4<br/>green border: ours · dark: Python (banned language) · blue: Go · yellow: NestJS"]
    telegram ~~~ legend

