%%{init: {"flowchart": {"wrappingWidth": 600, "nodeSpacing": 50, "rankSpacing": 90}, "themeVariables": {"fontSize": "15px"}}}%%
flowchart TB
    %% ranks, top to bottom: browser, gateway, broker, our services, then the teammates and Discovery side by side, Telegram

    client(["<b>Game client</b> · browser · nginx on :3000, /api proxied to the gateway"])

    gateway["<b>API Gateway</b> · Python / FastAPI · :8080 · the door for clients<br/>JWT check, X-Player-Id, task limits · knows the service from the path and puts the request on <b>its queue in the broker</b><br/><b>players only</b>: routes for services (/…/internal/…, POST /players/{id}/xp, …) → 404 · GET /ws/game → a Game copy, chosen by the broker<br/>X-Request-Id on every request"]

    broker["<b>Message Broker</b> (Lab 4) · Python, standard library only · :8070 · the door between services<br/><b>one thread per request</b> (ThreadingHTTPServer, HTTP/1.0) · 429 above MAX_CONCURRENT_TASKS · GET /topics<br/><b>gRPC :50051</b>: player.Player/* forwarded undecoded to a Player copy · events.Broker/Publish<br/><b>subscriber queue per service</b>: /queues/&lt;service&gt;/… from the gateway, /&lt;prefix&gt;/… between services · workers hand each message to one copy<br/><b>topics</b>: Publish → events.Consumer/Deliver on one copy of every subscribing service · subscriptions read from Discovery<br/><b>load-based</b>: fewest calls in progress · <b>circuit breaker</b>: 3 failures within TASK_TIMEOUT × 3.5 → removed and deregistered<br/><b>rerouting</b>: a failed call goes to another copy · <b>durable queues</b> in SQLite (broker-data) · <b>dead letter channel</b>: GET /dead-letters"]

    subgraph playercopies["Player (ours, Go) · 2 copies · replicas, no host port · share player-db"]
        direction LR
        player1["<b>player-1</b> · :8081 REST · :9081 gRPC<br/>accounts, login + JWT, XP,<br/>items, inventory, trades"]
        player2["<b>player-2</b> · :8081<br/>same image"]
    end

    subgraph gamecopies["Game (ours, Go) · 2 copies · share game-db · live events between them via Postgres NOTIFY / LISTEN · clock on the advisory-lock holder"]
        direction LR
        game1["<b>game</b> · :8082 · :9082 gRPC<br/>sessions, day/night,<br/>actions, zombies"]
        game2["<b>game-2</b> · :8083<br/>same image"]
    end

    subgraph team["Teammates' services · fixed URLs · own PostgreSQL each · among them: exam.completed, world.wing_unlocked"]
        direction LR
        exam["<b>Exam</b><br/>NestJS"]
        world["<b>World</b><br/>NestJS"]
        zombie["<b>Zombie</b><br/>NestJS"]
        resource["<b>Resource</b><br/>NestJS"]
        base["<b>Base</b><br/>Go"]
        crafting["<b>Crafting</b><br/>Go"]
    end

    discovery["<b>Service Discovery</b> · Python / FastAPI · :8090<br/>in-memory registry: /register (with topics, gRPC address) · /deregister · /services · /grpc · /subscriptions · /services/health<br/><b>health check</b> of every copy every 10 s: ok · critical (≥ 80 % or refusing) · unhealthy<br/>drops copies not renewed for 45 s"]

    telegram(["<b>Telegram</b> · developers' chat · ALERT · RESOLVED · REMOVED"])

    logs[("<b>logs volume</b> · /logs/&lt;service&gt;-&lt;hostname&gt;.log, rotated at 5 MB, 3 kept<br/>written by gateway, discovery, broker, every Player and Game copy<br/>one shape: time LEVEL [service-component] message req=…")]

    %% browser
    client -- "REST · cookie or Bearer" --> gateway
    client -. "WebSocket, direct · URL from GET /ws/game" .-> gamecopies

    %% every request through the broker
    gateway -- "/queues/&lt;service&gt;/… · every client request" --> broker
    broker -- "player queue (REST) · player.Player and events.Consumer (gRPC) · least loaded" --> playercopies
    broker -- "game queue (REST) · events.Consumer (gRPC) · least loaded" --> gamecopies
    broker -- "exam, world, zombie, resource, base, crafting queues" --> team
    gamecopies == "gRPC player.Player/* · events.Broker/Publish<br/>REST /world · internal key" ==> broker
    playercopies == "gRPC events.Broker/Publish:<br/>player.registered, player.leveled_up" ==> broker
    team -- "their calls to each other (REST, X-Internal-Key) · GATEWAY_URL = broker" --> broker

    %% control plane, straight to Discovery
    playercopies == "POST /register every 15 s<br/>GET /health every 10 s" ==> discovery
    gamecopies == "POST /register every 15 s<br/>GET /health every 10 s" ==> discovery
    gateway == "POST /register every 15 s" ==> discovery
    broker == "GET /services, /grpc, /subscriptions every 5 s<br/>POST /deregister on a breaker trip" ==> discovery
    broker -- "GET /logs (X-Internal-Key): every file merged by time" --> logs
    discovery -- "alerts" --> telegram

    %% monitoring
    subgraph monitoring["Monitoring · docker compose"]
        direction LR
        prometheus["<b>Prometheus</b> · :9090<br/>scrapes /metrics on :9100 of every copy"]
        alloy["<b>Alloy</b><br/>every container's output,<br/>via the Docker socket"]
        loki["<b>Loki</b><br/>logs, labels: service, level, tag"]
        grafana["<b>Grafana</b> · :3001<br/>one dashboard: metrics + logs"]
    end
    prometheus -- "GET /prometheus: what to scrape" --> discovery
    alloy --> loki
    grafana --> prometheus
    grafana --> loki

    %% events for the teammates' services (/events WebSockets, URL negotiated with the broker)
    playercopies -. "player.registered<br/>player.leveled_up" .-> team
    gamecopies -. "game.action_completed" .-> team

    legend["<b>Legend</b> · solid: REST, every request through the broker · thick into the broker: gRPC between our services<br/>thick into Discovery: registration, health checks, the registry and subscriptions · dashed: WebSockets opened directly<br/>green border: ours · dark: Python (banned language) · blue: Go · yellow: NestJS"]
    telegram ~~~ legend

