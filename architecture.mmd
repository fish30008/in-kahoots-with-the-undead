%%{init: {"flowchart": {"wrappingWidth": 900, "nodeSpacing": 30, "rankSpacing": 70}, "themeVariables": {"fontSize": "15px"}}}%%
flowchart TB
    client(["<b>Game client</b> (browser) · served by nginx on :3000, /api proxied to the gateway"])

    gateway["<b>API Gateway</b> · Python / FastAPI · :8080<br/>single entry point for client and service-to-service REST<br/>JWT authorization (Authorization header and login cookie are never forwarded, X-Player-Id is added) · task timeout + concurrent task limit<br/>WebSocket negotiation: GET /ws/{service} returns the URL to connect to directly"]

    client -- "REST · access_token cookie or Bearer" --> gateway
    client -. "WebSocket · URL negotiated at the gateway (GET /ws/game), then direct" .-> game

    subgraph services["Services · each owns its own PostgreSQL · service-to-service REST goes back through the gateway with X-Internal-Key"]
        direction LR
        player["<b>Player</b> · Go / chi · :8081<br/>players, login + JWT, XP, presence,<br/>item catalog, inventory"]
        game["<b>Game</b> · Go / chi + gorilla WebSocket · :8082<br/>sessions, day/night, timed actions, zombies<br/>PostgreSQL only, no Redis"]
        exam["<b>Exam</b> · NestJS · :8083<br/>exams, grades,<br/>achievements"]
        world["<b>World</b> · NestJS · :8084<br/>campus map, rooms,<br/>resource nodes"]
        zombie["<b>Zombie</b> · NestJS · :8085<br/>zombie types,<br/>stats, abilities"]
        resource["<b>Resource</b> · NestJS · :8086<br/>balances, ledger,<br/>reservations"]
        base["<b>Base</b> · Go · :8087<br/>upgrades, barricades,<br/>Kiki rewards"]
        crafting["<b>Crafting</b> · Go · :8088<br/>recipes, atomic<br/>crafting"]
    end

    gateway <-- "/auth /players" --> player
    gateway <-- "/game<br/>calls Player (XP, presence,<br/>inventory), Exam (mock by default)" --> game
    gateway <-- "/exams<br/>calls Zombie, Player" --> exam
    gateway <-- "/world" --> world
    gateway <-- "/zombies" --> zombie
    gateway <-- "/resources<br/>calls World" --> resource
    gateway <-- "/base<br/>calls Resource, World, Player" --> base
    gateway <-- "/crafting<br/>calls Resource, Player" --> crafting

    exam -. "exam.completed" .-> world
    exam -. "exam.completed" .-> crafting
    world -. "world.wing_unlocked" .-> crafting
    player -. "player.registered" .-> base
    player -. "player.leveled_up" .-> crafting

    legend["<b>Legend</b><br/>solid: REST through the gateway<br/>dashed: WebSocket opened directly on the producer<br/>(service /events streams are negotiated at the gateway too; Player, Exam, World and Resource serve one)<br/>green border: our services · blue: Go · yellow: NestJS · dark: gateway (banned language)"]
    services ~~~ legend

